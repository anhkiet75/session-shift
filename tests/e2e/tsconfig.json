{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": false,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "chrome"
    ],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "./**/*.ts",
    "../../playwright.config.ts"
  ]
}
