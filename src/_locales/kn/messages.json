  "autoInheritLabel": {
    "message": "ಲಿಂಕ್ ಮಾಡಿದ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ ತೆರೆಯಿರಿ"
  },
  "autoInheritDesc": {
    "message": "ಸಕ್ರಿಯಗೊಳಿಸಿದಾಗ, ಪ್ರತ್ಯೇಕಿಸಿದ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ ಲಿಂಕ್ (ಹೊಸ-ಟ್ಯಾಬ್ ಲಿಂಕ್‌ಗಳು, Ctrl-ಕ್ಲಿಕ್, ಮಿಡಲ್-ಕ್ಲಿಕ್) ಮೂಲಕ ತೆರೆದ ಟ್ಯಾಬ್‌ಗಳು Chrome ನ ಡೀಫಾಲ್ಟ್ ಕುಕೀಗಳ ಬದಲು ಅದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ ಉಳಿಯುತ್ತವೆ."
  },
  "groupTabsByProfileLabel": {
    "message": "ಟ್ಯಾಬ್ ಸ್ಟ್ರಿಪ್‌ನಲ್ಲಿ ಪ್ರೊಫೈಲ್ ಪ್ರಕಾರ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಗುಂಪು ಮಾಡಿ"
  },
  "groupTabsByProfileDesc": {
    "message": "ಪ್ರತಿ ಪ್ರೊಫೈಲ್‌ನ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಬಣ್ಣದ ಟ್ಯಾಬ್ ಗುಂಪಿನಲ್ಲಿ ಇರಿಸುತ್ತದೆ. ಟ್ಯಾಬ್ ಗುಂಪುಗಳನ್ನು ನಿರ್ವಹಿಸಲು Chrome ಅನುಮತಿ ಕೇಳುತ್ತದೆ. ಇದು ನಿಮ್ಮ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಮರುಹೊಂದಿಸುತ್ತದೆ, ಮತ್ತು ಗುಂಪಿನ ಬಣ್ಣಗಳು Chrome ನ 9 ಪೂರ್ವನಿಗದಿತ ಬಣ್ಣಗಳಿಗೆ ಸೀಮಿತವಾಗಿವೆ, ಆದ್ದರಿಂದ ಎರಡು ಪ್ರೊಫೈಲ್ ಬಣ್ಣಗಳು ಒಂದೇ ರೀತಿ ಕಾಣಿಸಬಹುದು."
  },
  "groupTabsPermissionDeniedNotice": {
    "message": "ಅನುಮತಿ ನಿರಾಕರಿಸಲಾಗಿದೆ. ಟ್ಯಾಬ್ ಗುಂಪುಗೊಳಿಸುವಿಕೆ ಆಫ್ ಆಗಿಯೇ ಉಳಿಯುತ್ತದೆ."
  },
  "aboutTagline": {
    "message": "ಪ್ರತಿ-ಟ್ಯಾಬ್ ಸೆಷನ್ ಪ್ರತ್ಯೇಕತೆಗಾಗಿ ಉಚಿತ, ಓಪನ್-ಸೋರ್ಸ್ Chrome ಎಕ್ಸ್‌ಟೆನ್ಷನ್. ಒಂದೇ ಸೈಟ್‌ನಲ್ಲಿ ಏಕಕಾಲದಲ್ಲಿ ಬಹು ಖಾತೆಗಳಲ್ಲಿ ಲಾಗ್ ಇನ್ ಆಗಿರಿ."
  },
  "supportSectionTitle": {
    "message": "ಯೋಜನೆಗೆ ಬೆಂಬಲ ನೀಡಿ"
  },
  "supportDesc": {
    "message": "SessionShift ಉಚಿತ ಮತ್ತು ಓಪನ್-ಸೋರ್ಸ್ ಆಗಿದೆ. ಇದು ನಿಮ್ಮ ಸಮಯ ಉಳಿಸಿದರೆ, ಸಣ್ಣ ಟಿಪ್ ನೀಡುವುದನ್ನು ಪರಿಗಣಿಸಿ — ಇದು ಯೋಜನೆಯನ್ನು ಜೀವಂತವಾಗಿ ಮತ್ತು ಜಾಹೀರಾತು-ಮುಕ್ತವಾಗಿ ಇಡುತ್ತದೆ."
  },
