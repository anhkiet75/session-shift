  },
  "autoInheritDesc": {
    "message": "सक्षम केल्यावर, वेगळ्या केलेल्या प्रोफाइलवर लिंक (नवीन-टॅब लिंक्स, Ctrl-क्लिक, मिडल-क्लिक) द्वारे उघडलेले टॅब Chrome च्या डीफॉल्ट कुकीजऐवजी त्याच प्रोफाइलमध्ये राहतात."
  },
  "groupTabsByProfileLabel": {
    "message": "टॅब स्ट्रिपमध्ये प्रोफाइलनुसार टॅब गटबद्ध करा"
  },
  "groupTabsByProfileDesc": {
    "message": "प्रत्येक प्रोफाइलचे टॅब रंगीत टॅब गटात ठेवते. Chrome टॅब गट व्यवस्थापित करण्यासाठी परवानगी मागेल. यामुळे तुमचे टॅब पुन्हा क्रमवारीत लावले जातील, आणि गटाचे रंग Chrome च्या 9 पूर्वनिर्धारित रंगांपुरते मर्यादित आहेत, त्यामुळे दोन प्रोफाइल रंग सारखे दिसू शकतात."
  },
  "groupTabsPermissionDeniedNotice": {
    "message": "परवानगी नाकारली. टॅब गटबद्धीकरण बंद राहील."
  },
  "aboutTagline": {
    "message": "प्रति-टॅब सेशन आयसोलेशनसाठी एक मोफत, ओपन-सोर्स Chrome एक्सटेंशन. एकाच साइटवर एकाच वेळी अनेक खात्यांमध्ये लॉग इन रहा."
  },
