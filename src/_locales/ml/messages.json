  "autoInheritLabel": {
    "message": "ലിങ്ക് ചെയ്ത ടാബുകൾ സ്വയമേവ അതേ പ്രൊഫൈലിൽ തുറക്കുക"
  },
  "autoInheritDesc": {
    "message": "പ്രവർത്തനക്ഷമമാക്കിയാൽ, വേർതിരിച്ച പ്രൊഫൈലിൽ ലിങ്ക് (പുതിയ-ടാബ് ലിങ്കുകൾ, Ctrl-ക്ലിക്ക്, മിഡിൽ-ക്ലിക്ക്) വഴി തുറക്കുന്ന ടാബുകൾ Chrome-ന്റെ ഡിഫോൾട്ട് കുക്കികൾക്ക് പകരം അതേ പ്രൊഫൈലിൽ തന്നെ തുടരും."
  },
  "groupTabsByProfileLabel": {
    "message": "ടാബ് സ്ട്രിപ്പിൽ പ്രൊഫൈൽ അനുസരിച്ച് ടാബുകൾ ഗ്രൂപ്പ് ചെയ്യുക"
  },
  "groupTabsByProfileDesc": {
    "message": "ഓരോ പ്രൊഫൈലിന്റെയും ടാബുകൾ ഒരു നിറമുള്ള ടാബ് ഗ്രൂപ്പിലേക്ക് ഇടുന്നു. ടാബ് ഗ്രൂപ്പുകൾ കൈകാര്യം ചെയ്യാൻ Chrome അനുമതി ചോദിക്കും. ഇത് നിങ്ങളുടെ ടാബുകൾ പുനഃക്രമീകരിക്കും, ഗ്രൂപ്പ് നിറങ്ങൾ Chrome-ന്റെ 9 മുൻനിശ്ചയിച്ച നിറങ്ങളിൽ പരിമിതമാണ്, അതിനാൽ രണ്ട് പ്രൊഫൈൽ നിറങ്ങൾ ഒരുപോലെ കാണപ്പെടാം."
  },
  "groupTabsPermissionDeniedNotice": {
    "message": "അനുമതി നിരസിച്ചു. ടാബ് ഗ്രൂപ്പിംഗ് ഓഫായി തുടരും."
  },
  "aboutTagline": {
    "message": "പ്രതി-ടാബ് സെഷൻ വേർതിരിവിനായുള്ള സൗജന്യ, ഓപ്പൺ-സോഴ്സ് Chrome എക്സ്റ്റൻഷൻ. ഒരേ സൈറ്റിൽ ഒരേസമയം ഒന്നിലധികം അക്കൗണ്ടുകളിൽ ലോഗിൻ ചെയ്തിരിക്കുക."
  },
  "supportSectionTitle": {
    "message": "പദ്ധതിയെ പിന്തുണയ്ക്കുക"
  },
  "supportDesc": {
    "message": "SessionShift സൗജന്യവും ഓപ്പൺ-സോഴ്സുമാണ്. ഇത് നിങ്ങളുടെ സമയം ലാഭിക്കുന്നെങ്കിൽ, ഒരു ചെറിയ ടിപ്പ് പരിഗണിക്കുക — ഇത് പദ്ധതിയെ സജീവവും പരസ്യരഹിതവുമായി നിലനിർത്തുന്നു."
  },
