  "autoInheritLabel": {
    "message": "இணைக்கப்பட்ட தாவல்களை தானாக அதே சுயவிவரத்தில் திற"
  },
  "autoInheritDesc": {
    "message": "இயக்கப்பட்டால், தனிமைப்படுத்தப்பட்ட சுயவிவரத்தில் இணைப்பு (புதிய-தாவல் இணைப்புகள், Ctrl-கிளிக், நடு-கிளிக்) மூலம் திறக்கப்படும் தாவல்கள் Chrome-இன் இயல்புநிலை குக்கீகளுக்குப் பதிலாக அதே சுயவிவரத்தில் தொடரும்."
  },
  "groupTabsByProfileLabel": {
    "message": "தாவல் பட்டியில் சுயவிவரப்படி தாவல்களை குழுவாக்கு"
  },
  "groupTabsByProfileDesc": {
    "message": "ஒவ்வொரு சுயவிவரத்தின் தாவல்களையும் வண்ண தாவல் குழுவில் வைக்கிறது. தாவல் குழுக்களை நிர்வகிக்க Chrome அனுமதி கேட்கும். இது உங்கள் தாவல்களை மறுவரிசைப்படுத்தும், மேலும் குழு வண்ணங்கள் Chrome இன் 9 முன்னமைக்கப்பட்ட வண்ணங்களுக்கு மட்டுப்படுத்தப்பட்டுள்ளன, எனவே இரண்டு சுயவிவர வண்ணங்கள் ஒரே மாதிரியாகத் தோன்றலாம்."
  },
  "groupTabsPermissionDeniedNotice": {
    "message": "அனுமதி மறுக்கப்பட்டது. தாவல் குழுவாக்கம் ஆஃப் ஆகவே இருக்கும்."
  },
  "aboutTagline": {
    "message": "ஒவ்வொரு-தாவல் தொடர் தனிமைப்படுத்தலுக்கான இலவச, திறந்த மூல Chrome நீட்டிப்பு. ஒரே தளத்தில் ஒரே நேரத்தில் பல கணக்குகளில் உள்நுழைந்திருங்கள்."
  },
  "supportSectionTitle": {
    "message": "திட்டத்தை ஆதரிக்கவும்"
  },
  "supportDesc": {
    "message": "SessionShift இலவசமும் திறந்த மூலமும் ஆகும். இது உங்கள் நேரத்தை மிச்சப்படுத்தினால், ஒரு சிறிய டிப் கொடுக்க பரிசீலிக்கவும் — இது திட்டத்தை உயிருடனும் விளம்பரமின்றியும் வைத்திருக்கும்."
  },
