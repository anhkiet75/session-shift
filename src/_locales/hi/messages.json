  "groupTabsByProfileLabel": {
    "message": "टैब स्ट्रिप में प्रोफ़ाइल के अनुसार टैब समूहित करें"
  },
  "groupTabsByProfileDesc": {
    "message": "प्रत्येक प्रोफ़ाइल के टैब को एक रंगीन टैब समूह में रखता है। Chrome टैब समूहों को प्रबंधित करने के लिए अनुमति मांगेगा। इससे आपके टैब फिर से व्यवस्थित हो जाएंगे, और समूह के रंग Chrome के 9 पूर्वनिर्धारित रंगों तक सीमित हैं, इसलिए दो प्रोफ़ाइल रंग एक जैसे दिख सकते हैं।"
  },
